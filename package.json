{
  "name": "nyangi",
  "version": "1.0.0",
  "description": "냥이 - 모니터 위를 걸어다니는 고양이 AI 친구",
  "main": "src/main.js",
  "author": "jaemin",
  "license": "MIT",
  "scripts": {
    "test": "node test/smoke.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.jaemin.nyangi",
    "productName": "Nyangi",
    "artifactName": "Nyangi-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "냥이",
      "runAfterFinish": true
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment"
    }
  }
}
